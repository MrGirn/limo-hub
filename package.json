{
  "name": "limo-sovereign-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/vendor_app/frontend",
    "packages/global_hub/frontend",
    "frontend"
  ],
  "scripts": {
    "dev:global-hub": "npm --workspace=@limo/global-hub-frontend run dev",
    "dev:vendor": "npm --workspace=@limo/vendor-app-frontend run dev",
    "build:global-hub": "npm --workspace=@limo/global-hub-frontend run build",
    "build:vendor": "npm --workspace=@limo/vendor-app-frontend run build",
    "build:all": "npm run build:global-hub && npm run build:vendor"
  }
}

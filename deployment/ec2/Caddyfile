# =============================================================
# Caddyfile: Automated SSL & Routing for Global Hub & ANB Cell
# =============================================================

# Global configuration: automated HTTPS
{
    email support@limo.network
}

# 1. Direct HTTP Port 80 Access & Default Fallback
:80 {
    reverse_proxy limo-cell-anb-philly:8000
}

# 2. Central Global Federation Hub (e.g. hub.yourdomain.com)
{$HUB_DOMAIN:hub.limo.network} {
    reverse_proxy limo-global-hub:8000
}

# 3. ANB Trans Inc Sovereign Cell (e.g. anb.yourdomain.com, philly.yourdomain.com)
{$ANB_DOMAIN:anb.limo.network}, {$PHILLY_DOMAIN:philly.limo.network} {
    reverse_proxy limo-cell-anb-philly:8000
}

# 4. Wildcard Subdomain & Root Domain Fallback to ANB Cell
{$ROOT_DOMAIN:limo.network}, *.{$PLATFORM_ROOT_DOMAIN:limo.network} {
    reverse_proxy limo-cell-anb-philly:8000
}


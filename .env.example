# ==============================================================================
# LIMO AUTONOMOUS FLEET & OPERATIONS PLATFORM - ENVIRONMENT TEMPLATE
# ==============================================================================

# --- 1. CORE PLATFORM & FEDERATION HUB ---
APP_MODE=production
DEMO_API_KEY=dev-demo-key-2026
LOCAL_TENANT_ID=tenant-us-east
GLOBAL_HUB_URL=http://limo-global-hub:8000
JWT_SECRET=your_jwt_signing_secret_here
LIMO_CELL_ENCRYPTION_SECRET=your_master_encryption_secret_here

# --- 2. PERSISTENT MYSQL DATABASE TIER ---
MYSQL_HOST=limo-mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_db_password_here
MYSQL_DATABASE=limo_db
MYSQL_URL=mysql+pymysql://root:your_db_password_here@limo-mysql:3306/limo_db

# --- 3. STRIPE PAYMENT GATEWAY & 85/10/5 SETTLEMENTS ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- 4. GOOGLE MAPS PLATFORM (3-LEG ROUTING & PLACES) ---
GOOGLE_MAPS_API_KEY=AIzaSy...
GOOGLE_GEOCODING_API_KEY=AIzaSy...
GOOGLE_PLACES_API_KEY=AIzaSy...

# --- 5. TWILIO OMNICHANNEL TELEPHONY, SMS & VOICE IVR ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+18449912296
SMS_ENABLED=true

# --- 6. FLIGHTAWARE AEROAPI V3 (LIVE FLIGHT RADAR & WHEELS-DOWN TRACKING) ---
AEROAPI_KEY=your_aeroapi_key_here
FLIGHTAWARE_API_KEY=your_aeroapi_key_here
AVIATIONSTACK_API_KEY=your_aviationstack_key_here

# --- 7. AI MODELS, VERTEX AI & DISPATCH REASONING ---
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service_account.json
VERTEX_PROJECT_ID=your_gcp_project_id
VERTEX_LOCATION=us-central1
AI_DAILY_CALL_LIMIT=1000
MODEL_MAX_OUTPUT_TOKENS=8192
OPENAI_API_KEY=sk-...
MODEL_NAME=gemini-2.5-flash
MODEL_BASE_URL=

# --- 8. AWS CLOUD STORAGE & SES INVOICE GATEWAY ---
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_VENDOR_SPECS_BUCKET=limo-vendor-definitions-prod
AWS_SES_FROM_EMAIL=billing@yourdomain.com

# --- 9. OBSERVABILITY & DISTRIBUTED TRACING ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
